PORT=5000
NODE_ENV=production

# --- Database (create a NEW database, e.g. fbbms, then run: npm run migrate) ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=fbbms

# --- Security ---
JWT_SECRET=change-this-to-a-long-random-string
# Comma-separated list of front-end origins allowed to call the API
ALLOWED_ORIGINS=https://management.fourbrothers.online,https://zanlux.online,https://www.zanlux.online,https://fourbrothers.online,http://localhost:5500,http://127.0.0.1:5500

# --- Email OTP for Developer & Super Admin sign-in (Zoho SMTP) ---
OTP_ENABLED=true
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
# SMTP_USER = full Zoho mailbox (e.g. no-reply@fourbrothers.online); SMTP_PASS = its password or app-specific password
SMTP_USER=
SMTP_PASS=
# SMTP_FROM="FBBMS" <no-reply@fourbrothers.online>   # optional; must be the same mailbox/alias as SMTP_USER

# --- Cloudinary (product photos) --- use ONE of the two styles
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- First-run seeding (npm run seed). Leave blank to auto-generate and print once ---
SEED_DEVELOPER_PASSWORD=
SEED_FOUNDER_PASSWORD=

# --- v3 additions ---
# Encrypts secrets saved from the Developer console (AI key). Use a long random string and NEVER change it later,
# or the saved AI key can no longer be read (you would simply enter it again). Falls back to JWT_SECRET if empty.
SETTINGS_KEY=
# Optional: first-run default for the AI key. Normally you enter the key in Developer console -> AI settings instead.
GROQ_API_KEY=
# Where logical database backups (.sql.gz) are written. Make sure this folder is NOT served publicly.
BACKUP_DIR=./backups
# Set to true to stop the built-in scheduler (daily summaries, backups, recurring expenses) on this instance
DISABLE_SCHEDULER=false
# Set to true to stop all outgoing email (useful for local testing)
DISABLE_EMAIL=false
# Testing only: allow webhooks and AI base URLs that point to localhost/private addresses. Keep false in production.
ALLOW_PRIVATE_WEBHOOKS=false
